+        # via disallowed_tools regardless of permission_mode. This deployment
+        # runs unattended (no approval callback wired), and the prompt carries
+        # attacker-influenceable pod-log/event text, so model judgement alone
+        # is not a boundary (verified: without this, Bash runs unprompted on
+        # the VM). Read/Grep/Glob and the read-only K8s MCP tools stay available.
+        fields["disallowed_tools"] = [
+            "Bash",
+            "BashOutput",
+            "KillShell",
+            "Write",
+            "Edit",
+            "MultiEdit",
+            "NotebookEdit",
